[Unit]
Description=agentty.org recordings: check for a new agentty release every 3 h

[Timer]
# Cheap when agentty hasn't changed (one HTTP request); re-records only when
# the latest release is newer than what the recordings show.
OnBootSec=15min
OnUnitActiveSec=3h
Persistent=true

[Install]
WantedBy=timers.target
