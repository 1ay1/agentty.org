[Unit]
Description=Redeploy agentty.org when a new agentty release is published
Documentation=https://github.com/1ay1/agentty.org
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ayush
WorkingDirectory=/home/ayush/projects/agentpp-site
# A GitHub token lifts the API rate limit from 60/hr to 5000/hr (optional).
# Drop a line `GITHUB_TOKEN=ghp_...` in this file to enable it.
EnvironmentFile=-/home/ayush/projects/agentpp-site/deploy/.env
ExecStart=/home/ayush/projects/agentpp-site/scripts/redeploy-on-release.sh
# deploy.sh needs sudo for rsync to /var/www + nginx reload. Grant this user
# passwordless sudo for exactly those, or run the whole unit as a deploy role.
TimeoutStartSec=600
Nice=10
