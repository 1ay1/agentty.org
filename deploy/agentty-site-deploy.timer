[Unit]
Description=Poll for new agentty releases and redeploy the site
Documentation=https://github.com/1ay1/agentty.org

[Timer]
# Check 5 min after boot, then every 15 min. Only actually redeploys when the
# latest release tag changed (the script no-ops otherwise), so the cost of a
# tight interval is one cheap GitHub API call.
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
